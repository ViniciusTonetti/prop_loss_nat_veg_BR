unique(MB$biome)
unique(MB$class_level_0)
MB %>%
filter(class_level_0 == "Natural")
MB %>%
filter(class_level_0 == "Natural")
colnames(MB %>%
filter(class_level_0 == "Natural"))
MB %>%
filter(class_level_0 == "Natural") %>%
select(biome, "2024")
